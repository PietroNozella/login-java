# Copie para .env e ajuste. Nunca commite o .env com senhas reais.
MONGODB_URI=mongodb://mongo:27017/login_java
MONGODB_DATABASE=login_java
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=troque-aqui
APP_ADMIN_EMAIL=admin@local
APP_ADMIN_NOME=Administrador
APP_BASE_URL=http://localhost:8080
APP_NOME=Sistema de Login
APP_TEMA_NOME=padrao

# SMTP usado na recuperação de senha. O Docker Compose inclui o Mailpit.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_FROM=no-reply@localhost
